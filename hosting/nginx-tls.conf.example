# Loopback acceptance test. Set both paths to the approved certificate and key.
server {
    listen 127.0.0.1:18443 ssl;
    server_name strobisoft.com www.strobisoft.com;
    ssl_certificate /etc/strobisoft/tls/fullchain.pem;
    ssl_certificate_key /etc/strobisoft/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/strobisoft/current/public;
    index index.html;
    autoindex off;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location / { try_files $uri $uri/ =404; }
    location ~ /\. { deny all; }
}
